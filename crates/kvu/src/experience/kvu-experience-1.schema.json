                    "nom": { "minLength": 1, "type": "string" },
                    "source": { "minLength": 1, "type": "string" },
                    "statut_lecture": { "enum": ["[calcul exact]", "[numérique]", "[lecture]", "[estimé]"] },
                    "valeur": { "type": "number" }
                  },
                  "required": ["nom", "valeur", "statut_lecture", "source"],
                  "type": "object"
                },
                "type": "array"
              },
              "classe": { "enum": ["A", "B"] },
              "provisoire": { "type": "boolean" },
              "precedent": { "format": "sha256", "type": "string" },
              "remplace_le": { "minLength": 1, "type": "string" },
              "statut": { "enum": ["en_cours", "non_concluant", "compatible", "refute", "indetermine"] },
              "texte": { "type": "string" }
            },
            "required": ["statut", "provisoire", "classe", "texte", "chiffres", "remplace_le"],
            "type": "object"
          },
          "type": "array"
        },
        "chaine": { "format": "sha256", "type": "string" },
        "migre_le": { "minLength": 1, "type": "string" },
        "provisoire": { "type": "boolean" },
        "statut": { "enum": ["en_cours", "non_concluant", "compatible", "refute", "indetermine"] },
        "texte": { "type": "string" }
      },
      "required": ["statut", "provisoire", "classe", "texte", "chiffres", "historique"],
      "type": "object"
    }
