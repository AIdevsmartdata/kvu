              "arch": { "type": ["string", "null"] },
              "backend": { "type": ["string", "null"] },
              "sha256": { "format": "sha256", "type": "string" },
              "source_hash": { "format": "sha256", "type": ["string", "null"] },
              "version": { "type": ["string", "null"] },
              "versions": { "type": "object" }
            },
            "required": ["sha256", "source_hash", "version", "arch", "backend", "versions"],
            "type": "object"
          },
          "type": "array"
        },
        "branche": { "type": "string" },
        "commit": { "type": "string" }
      },
      "required": ["commit", "branche", "binaires"],
      "type": "object"
    },
    "donnees": { "type": "object" },
    "graines": {
