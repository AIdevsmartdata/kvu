              "sha256": { "format": "sha256", "type": "string" }
            },
            "required": ["chemin", "sha256"],
            "type": "object"
          },
          "statut": { "enum": ["vert", "rouge", "rouge_attendu", "non_lance"] },
          "valeur": { "type": ["number", "string", "boolean", "null"] }
        },
        "required": ["id", "enonce", "seuil", "valeur", "statut", "source", "mutant"],
        "then": { "properties": { "mutant": { "minLength": 1, "type": "string" } } },
        "type": "object"
      },
      "type": "array"
    },
    "prereg": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change_un_critere": { "type": "boolean" },
          "chemin": { "minLength": 1, "type": "string" },
          "gele_le": { "minLength": 1, "type": "string" },
          "gele_source": { "enum": ["mtime", "declare"] },
          "hachage_consigne": { "minLength": 1, "type": "string" },
          "hachage_consigne_sha256": { "format": "sha256", "type": "string" },
          "id": { "minLength": 1, "type": "string" },
          "remplace": { "type": ["string", "null"] },
          "sections": { "items": { "type": "string" }, "type": "array" },
