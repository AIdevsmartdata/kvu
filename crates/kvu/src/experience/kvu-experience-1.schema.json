        "required": ["id", "chemin", "sha256", "gele_le", "gele_source", "change_un_critere", "remplace"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "question": { "minLength": 1, "type": "string" },
    "reserves": { "items": { "type": "string" }, "type": "array" },
    "runs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binaire_sha256": { "format": "sha256", "type": "string" },
          "debut": { "minLength": 1, "type": "string" },
          "fin": { "minLength": 1, "type": "string" },
          "geometrie": {
            "additionalProperties": false,
            "properties": {
              "cotes": { "items": { "minimum": 1, "type": "integer" }, "type": "array" }
            },
            "required": ["cotes"],
            "type": "object"
          },
          "graines": { "items": { "minimum": 0, "type": "integer" }, "type": "array" },
          "hote": { "minLength": 1, "type": "string" },
          "id": { "minLength": 1, "type": "string" },
          "machine": { "minLength": 1, "type": "string" },
          "manifeste": { "minLength": 1, "type": "string" },
          "parametres": { "type": "object" },
          "prereg": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
          "rc": { "type": "integer" },
          "schema": { "const": "kevinotron-unifie/1" },
          "sha256": { "format": "sha256", "type": "string" },
          "sortie": {
            "additionalProperties": false,
            "properties": {
              "chemin": { "minLength": 1, "type": "string" },
              "sha256": { "format": "sha256", "type": "string" }
            },
            "required": ["chemin", "sha256"],
            "type": "object"
          }
        },
        "required": [
          "id", "manifeste", "sha256", "schema", "machine", "hote", "debut", "fin",
          "rc", "graines", "binaire_sha256", "geometrie", "parametres", "prereg"
