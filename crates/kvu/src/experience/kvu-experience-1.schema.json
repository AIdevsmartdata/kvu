      "required": ["cree_le", "modifie_le"],
      "type": "object"
    },
    "id": { "minLength": 1, "type": "string" },
    "incidents": { "type": "array" },
    "index": { "type": "object" },
    "machine_principale": { "minLength": 1, "type": "string" },
    "machines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "arch": { "type": ["string", "null"] },
          "backend": { "type": ["string", "null"] },
          "classe": { "enum": ["A", "B"] },
          "hote": { "minLength": 1, "type": "string" },
          "nom": { "minLength": 1, "type": "string" }
        },
        "required": ["nom", "hote", "backend", "arch", "classe"],
        "type": "object"
      },
      "type": "array"
    },
    "portes": {
      "items": {
        "additionalProperties": false,
        "if": { "properties": { "statut": { "const": "rouge_attendu" } } },
        "properties": {
          "enonce": { "minLength": 1, "type": "string" },
          "id": { "minLength": 1, "type": "string" },
          "mutant": { "type": ["string", "null"] },
          "seuil": { "type": ["number", "string", "boolean", "null"] },
