{
  "additionalProperties": false,
  "properties": {
    "anteriorite": {
      "additionalProperties": false,
      "properties": {
        "garde": {
          "additionalProperties": false,
          "properties": {
            "chemin": { "minLength": 1, "type": "string" },
            "sha256": { "format": "sha256", "type": "string" }
          },
          "required": ["chemin", "sha256"],
          "type": "object"
        },
        "sha256sums": {
          "additionalProperties": false,
          "properties": {
            "chemin": { "minLength": 1, "type": "string" },
            "sha256": { "format": "sha256", "type": "string" }
          },
          "required": ["chemin", "sha256"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "auteurs": { "type": "object" },
    "carnet": {
      "items": {
        "additionalProperties": false,
        "if": { "properties": { "type": { "const": "resultat" } } },
        "properties": {
          "date": { "minLength": 1, "type": "string" },
          "enonce": { "minLength": 1, "type": "string" },
          "id": { "minLength": 1, "type": "string" },
          "liens": { "items": { "minLength": 1, "type": "string" }, "type": "array" },
          "sources": {
            "items": { "minLength": 1, "type": "string" },
            "minItems": 1,
            "type": "array"
          },
          "statut": {
            "enum": [
              "numerique", "proposition_une_famille", "retrograde", "echec",
              "lecture", "une_famille", "a_corriger", "corrigee", "garde_fabriquee",
              "sans_consequence", "prise", "en_attente", "ouverte",
              "conditionnelle", "en_test", "refutee", "retiree", "bornee", "close", "gelee"
            ],
            "type": "string"
          },
          "titre": { "minLength": 1, "type": "string" },
          "tomberait": { "type": "string" },
          "type": { "enum": ["resultat", "erreur", "decision", "hypothese", "piste", "fait"] }
        },
        "required": ["type", "id", "titre", "statut", "enonce", "sources", "liens", "date"],
        "then": {
          "properties": {
            "statut": { "enum": ["numerique", "proposition_une_famille", "retrograde", "echec"] }
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "carnet_id": { "minLength": 5, "type": "string" },
    "chemin_projet": { "minLength": 1, "type": "string" },
    "code": {
      "additionalProperties": false,
      "properties": {
        "binaires": {
          "items": {
            "additionalProperties": false,
