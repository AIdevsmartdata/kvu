      "properties": {
        "regle": { "type": "string" },
        "toutes_distinctes": { "type": "boolean" }
      },
      "required": ["toutes_distinctes"],
      "type": "object"
    },
    "horodatage": {
      "additionalProperties": false,
      "properties": {
        "cree_le": { "minLength": 1, "type": "string" },
        "horloge_imposee": { "type": "boolean" },
        "modifie_le": { "minLength": 1, "type": "string" }
