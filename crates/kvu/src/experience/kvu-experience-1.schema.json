        "type": "object"
      },
      "type": "array"
    },
    "schema": { "const": "kvu-experience/1" },
    "titre": { "minLength": 1, "type": "string" },
    "verdict": {
      "additionalProperties": false,
      "properties": {
        "chiffres": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "nom": { "minLength": 1, "type": "string" },
              "source": { "minLength": 1, "type": "string" },
              "statut_lecture": { "enum": ["[calcul exact]", "[numérique]", "[lecture]", "[estimé]"] },
              "valeur": { "type": "number" }
            },
            "required": ["nom", "valeur", "statut_lecture", "source"],
            "type": "object"
          },
          "type": "array"
        },
        "classe": { "enum": ["A", "B"] },
        "historique": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "chiffres": {
                "items": {
                  "additionalProperties": false,
